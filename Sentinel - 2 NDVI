#Libraries
import pystac_client
import planetary_computer
from pystac.extensions.eo import EOExtension as eo

import rasterio
from rasterio import windows, features, warp

import numpy as np
import matplotlib.pyplot as plt


# Connect to API
catalog = pystac_client.Client.open(
    "https://planetarycomputer.microsoft.com/api/stac/v1",
    modifier=planetary_computer.sign_inplace,
)

# AOI and date 
area_of_interest = {
    "type": "Polygon",
    "coordinates": [
        [
            [80.2300, 13.0200],
            [80.3100, 13.0200],
            [80.3100, 13.0900],
            [80.2300, 13.0900],
            [80.2300, 13.0200]
        ]
    ]
}

time_of_interest = "2019-03-01/2019-05-01"


# Scene Sentinel-2 
search = catalog.search(
    collections=["sentinel-2-l2a"],
    intersects=area_of_interest,
    datetime=time_of_interest,
    query={"eo:cloud_cover": {"lt": 10}},
)

items = search.item_collection()
item = min(items, key=lambda i: eo.ext(i).cloud_cover)


# Band selection for NDVI

assets = item.assets
red_href = assets["B04"].href   # Red
nir_href = assets["B08"].href   # NIR


def read_aoi(href):
    with rasterio.open(href) as ds:
        bounds = features.bounds(area_of_interest)
        bounds = warp.transform_bounds("EPSG:4326", ds.crs, *bounds)
        window = windows.from_bounds(*bounds, transform=ds.transform)
        return ds.read(1, window=window).astype("float32")

red = read_aoi(red_href)
nir = read_aoi(nir_href)


# NDVI calculation
ndvi = (nir - red) / (nir + red)


# Visualize NDVI
plt.figure(figsize=(6,6))
plt.imshow(ndvi, cmap="RdYlGn", vmin=0, vmax=1)
plt.colorbar(label="NDVI")
plt.title("NDVI – Chennai")
plt.axis("off")
plt.show()
