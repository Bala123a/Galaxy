import pystac_client
import planetary_computer
from pystac.extensions.eo import EOExtension as eo

import rasterio
from rasterio import windows, features, warp

import numpy as np
import matplotlib.pyplot as plt

#Planetary computer API
catalog = pystac_client.Client.open(
    "https://planetarycomputer.microsoft.com/api/stac/v1",
    modifier=planetary_computer.sign_inplace,
)
#Area of Interest with date - Chennai
area_of_interest = {
    "type": "Polygon",
    "coordinates": [
        [
            [80.2300, 13.0200],
            [80.3100, 13.0200],
            [80.3100, 13.0900],
            [80.2300, 13.0900],
            [80.2300, 13.0200]
        ]
    ]
}

time_of_interest = "2019-06-01/2019-08-01"
# Cloud filtering == 10 %
search = catalog.search(
    collections=["sentinel-2-l2a"],
    intersects=area_of_interest,
    datetime=time_of_interest,
    query={"eo:cloud_cover": {"lt": 10}},
)

items = search.item_collection()
print(f"Returned {len(items)} items")

least_cloudy_item = min(items, key=lambda item: eo.ext(item).cloud_cover)
print(
    f"Using {least_cloudy_item.id} | "
    f"Cloud cover = {eo.ext(least_cloudy_item).cloud_cover}%"
)

#  False colour composits and Scene classification Layer (SCL)
assets = least_cloudy_item.assets

nir_href   = assets["B08"].href   # NIR 
red_href   = assets["B04"].href   # Red 
green_href = assets["B03"].href   # Green 
scl_href   = assets["SCL"].href   # SCL 

# Reading AOI 

def read_aoi(href):
    with rasterio.open(href) as ds:
        aoi_bounds = features.bounds(area_of_interest)
        warped_bounds = warp.transform_bounds(
            "EPSG:4326", ds.crs, *aoi_bounds
        )
        window = windows.from_bounds(
            *warped_bounds, transform=ds.transform
        )
        data = ds.read(1, window=window)
        return data, ds.transform, ds.crs

#Bnads 
nir, transform, crs = read_aoi(nir_href)
red, _, _           = read_aoi(red_href)
green, _, _         = read_aoi(green_href)
scl, _, _           = read_aoi(scl_href)

# Here the SCL was 20 meters and other bands were 10 meters to upsacle was implemented to a common resolution of 10 meters. Using nearest neighbor we converted 20 meters to 10 meters
scl_upsampled = np.repeat(np.repeat(scl, 2, axis=0), 2, axis=1)
min_height = min(scl_upsampled.shape[0], nir.shape[0])
min_width = min(scl_upsampled.shape[1], nir.shape[1])

scl_upsampled_aligned = scl_upsampled[:min_height, :min_width]
nir_aligned = nir[:min_height, :min_width]
red_aligned = red[:min_height, :min_width]
green_aligned = green[:min_height, :min_width]


#Visualization before cloud masking
fcc = np.stack([nir_aligned, red_aligned, green_aligned], axis=0).astype("float32")

# Percentile stretch
p2, p98 = np.nanpercentile(fcc, (2, 98))
fcc_vis = np.clip((fcc - p2) / (p98 - p2), 0, 1)

plt.figure(figsize=(6,6))
plt.imshow(np.moveaxis(fcc_vis, 0, -1))
plt.title("False Color Composite (Before Cloud Mask)")
plt.axis("off")
plt.show()

# SCL cloud mask USGS have classes for masking cloud 
cloud_classes = [3, 8, 9, 10]
# Use the aligned upsampled SCL data for cloud mask generation
cloud_mask = np.isin(scl_upsampled_aligned, cloud_classes)

nir_masked   = np.where(cloud_mask, np.nan, nir_aligned)
red_masked   = np.where(cloud_mask, np.nan, red_aligned)
green_masked = np.where(cloud_mask, np.nan, green_aligned)

# Visualizing after cloud masking

fcc_clean = np.stack(
    [nir_masked, red_masked, green_masked], axis=0
)

# Stretching the pixewl values for reducing/ ignore Nan values and for balanced image rather choosing minimum and maximum range
#Extreme outliers are surpassed and dynamic range is preserved
p2, p98 = np.nanpercentile(fcc_clean, (2, 98))
fcc_clean_vis = np.clip(
    (fcc_clean - p2) / (p98 - p2), 0, 1 #Normalization for evenly stretch proportionally
)

#plotting
plt.figure(figsize=(6,6))
plt.imshow(np.moveaxis(fcc_clean_vis, 0, -1))
plt.title(" SCL Cloud Mask- Chennai")
plt.axis("off")
plt.show()
